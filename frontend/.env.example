# ==========================================
# EXEMPLO DE CONFIGURAÇÃO - FRONTEND (.env.example)
# Copie este arquivo para .env e ajuste se necessário
# ==========================================

# URL base da API
# 1) Automático (vazio): detecta o IP atual do navegador na porta 8000
# VITE_API_URL=

# 2) IP explícito da VM:
# VITE_API_URL=http://192.168.1.50:8000/api

# 3) Produção com Nginx unificado (porta 80/443):
# VITE_API_URL=/api
VITE_API_URL=
