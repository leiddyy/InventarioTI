[Unit]
Description=Inventario TI DIA - FastAPI Backend
After=network.target

[Service]
User=root
WorkingDirectory=/var/www/inventario-ti/backend
EnvironmentFile=/var/www/inventario-ti/backend/.env
ExecStart=/var/www/inventario-ti/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
