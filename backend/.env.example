# ==========================================
# EXEMPLO DE CONFIGURAÇÃO - BACKEND (.env.example)
# ==========================================

# 1) Para desenvolvimento local offline (SQLite):
DATABASE_URL=sqlite:///./inventario_ti.db

# 2) Para SUPABASE em Produção:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Servidor Backend
HOST=0.0.0.0
PORT=8000

# CORS (* ou origens separadas por vírgula)
CORS_ORIGINS=*

# Diretório para armazenamento de termos assinados
UPLOAD_DIR=uploads/termos
