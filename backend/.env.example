# ==========================================
# EXEMPLO DE CONFIGURAÇÃO - BACKEND (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.
# ==========================================

# 1) Configuração com SQLite (Padrão simples para testes / desenvolvimento):
DATABASE_URL=sqlite:///./inventario_ti.db

# 2) Configuração com PostgreSQL (Recomendado para Máquina Virtual em produção):
# DATABASE_URL=postgresql://inventario_user:sua_senha_segura@localhost:5432/inventario_ti

# Host e Porta do servidor FastAPI
HOST=0.0.0.0
PORT=8000

# CORS (origens permitidas separadas por vírgula ou * para liberar todas)
CORS_ORIGINS=*

# Diretório para armazenamento dos arquivos de termos assinados
UPLOAD_DIR=uploads/termos
